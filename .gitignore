# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Local virtual environment and the virtualenv bootstrap (see the Installation section of the README).
# virtualenv already writes a .gitignore with '*' inside .venv/, but the rule is kept
# here too in case the environment is recreated by another tool.
.venv/
.tools/
venv/
env/

# Results generated on every run (run_edc.py writes to results/YYYYMMDD_HHMMSS_<name>/)
results/

# Local tool/editor configuration
.claude/
.vscode/
.idea/
.DS_Store
