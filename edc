#!/usr/bin/env bash
# Local launcher: runs edc.py with the project's own virtual environment, from any
# directory. Keeps PYTHONDONTWRITEBYTECODE on so the folder stays free of __pycache__.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [ ! -x "$HERE/.venv/bin/python" ]; then
  echo "Local environment not found at $HERE/.venv" >&2
  echo "Create it following the 'Installation' section of README.md" >&2
  exit 1
fi
export PYTHONDONTWRITEBYTECODE=1
exec "$HERE/.venv/bin/python" "$HERE/edc.py" "$@"
